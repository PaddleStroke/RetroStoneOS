# U-Boot environment (A/B boot state) for fw_printenv / fw_setenv.
# Must match board/orangepi5/uboot.fragment: redundant, 64 KiB copies at
# 14 MiB and 14 MiB + 64 KiB on the SD card, after u-boot-rockchip.bin
# (32 KiB .. ~10 MiB) and before the first partition (16 MiB).
# Device	Offset		Size
/dev/mmcblk0	0xe00000	0x10000
/dev/mmcblk0	0xe10000	0x10000
