# RetroStone1 U-Boot options, merged after orangepi_one_defconfig and
# board/sbc-uboot/uboot.fragment. The Orange Pi One U-Boot fits: same CPU
# voltage switch (PL6, no I2C regulator to talk to; the PC's SY8106A code
# would drive PL0/PL1, which are WiFi test pads here), SD card detect on PF6,
# DRAM auto-sizing (the RetroStone1 has 2 x K4B4G1646D DDR3 = 1 GiB, 32-bit).

# DRAM clock: 624 MHz, the Orange Pi PC's value for the same two-chip
# 1 GiB layout (the One's default is 672 MHz for its own routing).
# TODO(hw): check stability (memtester), then try 672.
CONFIG_DRAM_CLK=624

# The Orange Pi One SPL lights its power LED on PL10; nothing is wired to
# PL10 on the RetroStone1.
# CONFIG_SPL_SUNXI_LED_STATUS is not set

# Environment (A/B boot state) as on the RetroStone2: two 64 KiB copies at
# 1 MiB and 1 MiB + 64 KiB, between u-boot-sunxi-with-spl.bin (8 KiB..1 MiB)
# and the first partition (4 MiB). Must match /etc/fw_env.config.
CONFIG_ENV_OFFSET=0x100000
CONFIG_ENV_OFFSET_REDUND=0x110000

# Hardware watchdog: U-Boot starts the H3 watchdog with its maximum timeout
# (16 s) and services it until the kernel starts; the kernel's sunxi_wdt
# finds it running and services it (CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED)
# until the frontend opens /dev/watchdog. A kernel that hangs anywhere
# resets the board, and boot.scr counts that boot as failed.
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=16000

# Boot speed: no U-Boot video (the kernel brings up HDMI; U-Boot has no H3
# composite output anyway), no network, no USB.
# CONFIG_VIDEO is not set
# CONFIG_VIDEO_DE2 is not set
# CONFIG_SUN8I_EMAC is not set
CONFIG_NO_NET=y
# CONFIG_NET is not set
# CONFIG_USB is not set
# CONFIG_CMD_USB is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
