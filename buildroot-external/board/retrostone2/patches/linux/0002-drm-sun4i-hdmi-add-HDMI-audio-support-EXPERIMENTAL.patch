diff --git a/drivers/gpu/drm/sun4i/sun4i_hdmi_audio.c b/drivers/gpu/drm/sun4i/sun4i_hdmi_audio.c
new file mode 100644
index 000000000..2adbf77f8
--- /dev/null
+++ b/drivers/gpu/drm/sun4i/sun4i_hdmi_audio.c
@@ -0,0 +1,328 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Allwinner A10/A10s/A20/A31 HDMI audio
+ *
+ * The register programming comes from "drm: sun4i: hdmi: Add support for
+ * sun4i HDMI encoder audio" (v3, January 2020) by Stefan Mavrodiev
+ * <stefan@olimex.com>, which was itself based on the Allwinner BSP and was
+ * tested on the A20, but was never merged. This version is reworked on top
+ * of the generic DRM HDMI audio helpers (hdmi-codec), like vc4_hdmi:
+ *
+ *  - the CPU DAI is the HDMI audio FIFO, fed by the dedicated DMA
+ *    channel "audio-tx" through the generic dmaengine PCM;
+ *  - the codec DAI is hdmi-codec, created by drm_connector_hdmi_audio_init(),
+ *    which provides the ELD control, the ELD constraints and the jack;
+ *  - the sound card is registered once at bind time instead of at every
+ *    modeset, as requested in the v1/v3 review.
+ */
+
+#include <linux/device.h>
+#include <linux/dmaengine.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+
+#include <drm/display/drm_hdmi_audio_helper.h>
+#include <drm/display/drm_hdmi_helper.h>
+#include <drm/display/drm_hdmi_state_helper.h>
+#include <drm/drm_print.h>
+
+#include <sound/asoundef.h>
+#include <sound/dmaengine_pcm.h>
+#include <sound/hdmi-codec.h>
+#include <sound/jack.h>
+#include <sound/pcm.h>
+#include <sound/soc.h>
+
+#include "sun4i_hdmi.h"
+
+#define connector_to_sun4i_hdmi(c)		\
+	container_of_const(c, struct sun4i_hdmi, connector)
+
+/* Called with hdmi->audio.lock held */
+static void sun4i_hdmi_audio_set_n_cts(struct sun4i_hdmi *hdmi)
+{
+	unsigned int n, cts;
+
+	if (!hdmi->audio.sample_rate || !hdmi->audio.tmds_rate)
+		return;
+
+	drm_hdmi_acr_get_n_cts(hdmi->audio.tmds_rate, hdmi->audio.sample_rate,
+			       &n, &cts);
+
+	regmap_write(hdmi->regmap, SUN4I_HDMI_AUDIO_CTS_REG,
+		     SUN4I_HDMI_AUDIO_CTS(cts));
+	regmap_write(hdmi->regmap, SUN4I_HDMI_AUDIO_N_REG,
+		     SUN4I_HDMI_AUDIO_N(n));
+}
+
+/* Called from the encoder enable path, to follow TMDS clock changes */
+void sun4i_hdmi_audio_mode_set(struct sun4i_hdmi *hdmi,
+			       unsigned long long tmds_rate)
+{
+	mutex_lock(&hdmi->audio.lock);
+	hdmi->audio.tmds_rate = tmds_rate;
+	sun4i_hdmi_audio_set_n_cts(hdmi);
+	mutex_unlock(&hdmi->audio.lock);
+}
+
+static int sun4i_hdmi_audio_startup(struct drm_connector *connector)
+{
+	/* A DVI sink cannot receive audio packets */
+	if (!connector->display_info.is_hdmi)
+		return -ENODEV;
+
+	return 0;
+}
+
+static int sun4i_hdmi_audio_prepare(struct drm_connector *connector,
+				    struct hdmi_codec_daifmt *fmt,
+				    struct hdmi_codec_params *hparms)
+{
+	struct sun4i_hdmi *hdmi = connector_to_sun4i_hdmi(connector);
+	unsigned int channels = hparms->channels;
+	u32 reg;
+	int ret;
+
+	if (channels < 1 || channels > 8)
+		return -EINVAL;
+
+	mutex_lock(&hdmi->audio.lock);
+
+	/* Reset the audio block, the reset bit clears itself */
+	regmap_write(hdmi->regmap, SUN4I_HDMI_AUDIO_CTRL_REG, 0);
+	regmap_write(hdmi->regmap, SUN4I_HDMI_AUDIO_CTRL_REG,
+		     SUN4I_HDMI_AUDIO_CTRL_RESET);
+	ret = regmap_read_poll_timeout(hdmi->regmap, SUN4I_HDMI_AUDIO_CTRL_REG,
+				       reg, !(reg & SUN4I_HDMI_AUDIO_CTRL_RESET),
+				       100, 50000);
+	if (ret) {
+		drm_err(connector->dev, "Failed to reset the HDMI audio block\n");
+		goto out_unlock;
+	}
+
+	/* Two channels use layout 0, more channels use layout 1 */
+	regmap_update_bits(hdmi->regmap, SUN4I_HDMI_AUDIO_FMT_REG,
+			   SUN4I_HDMI_AUDIO_FMT_LAYOUT |
+			   SUN4I_HDMI_AUDIO_FMT_CH_CFG_MASK,
+			   (channels > 2 ? SUN4I_HDMI_AUDIO_FMT_LAYOUT : 0) |
+			   SUN4I_HDMI_AUDIO_FMT_CH_CFG(channels));
+
+	/* Identity channel map */
+	regmap_write(hdmi->regmap, SUN4I_HDMI_AUDIO_PCM_REG,
+		     SUN4I_HDMI_AUDIO_PCM_CH_MAP_IDENTITY);
+
+	/* IEC 60958 channel status: sampling frequency (bits 24-27) */
+	regmap_update_bits(hdmi->regmap, SUN4I_HDMI_AUDIO_STAT0_REG,
+			   SUN4I_HDMI_AUDIO_STAT0_FREQ_MASK,
+			   SUN4I_HDMI_AUDIO_STAT0_FREQ(hparms->iec.status[3] &
+						       IEC958_AES3_CON_FS));
+
+	hdmi->audio.sample_rate = hparms->sample_rate;
+	sun4i_hdmi_audio_set_n_cts(hdmi);
+
+	regmap_write(hdmi->regmap, SUN4I_HDMI_AUDIO_CTRL_REG,
+		     SUN4I_HDMI_AUDIO_CTRL_ENABLE);
+
+out_unlock:
+	mutex_unlock(&hdmi->audio.lock);
+	if (ret)
+		return ret;
+
+	return drm_atomic_helper_connector_hdmi_update_audio_infoframe(connector,
+								       &hparms->cea);
+}
+
+static void sun4i_hdmi_audio_shutdown(struct drm_connector *connector)
+{
+	struct sun4i_hdmi *hdmi = connector_to_sun4i_hdmi(connector);
+
+	mutex_lock(&hdmi->audio.lock);
+	regmap_write(hdmi->regmap, SUN4I_HDMI_AUDIO_CTRL_REG, 0);
+	hdmi->audio.sample_rate = 0;
+	mutex_unlock(&hdmi->audio.lock);
+
+	drm_atomic_helper_connector_hdmi_clear_audio_infoframe(connector);
+}
+
+static const struct drm_connector_hdmi_audio_funcs sun4i_hdmi_audio_funcs = {
+	.startup	= sun4i_hdmi_audio_startup,
+	.prepare	= sun4i_hdmi_audio_prepare,
+	.shutdown	= sun4i_hdmi_audio_shutdown,
+};
+
+/*
+ * The audio FIFO is fed by a dedicated DMA channel (DDMA DRQ 24). As in the
+ * Allwinner BSP and in the original patch, the destination address is left
+ * at 0: the DDMA HDMI audio port is selected by its DRQ type only.
+ * TODO(hw): confirm on the RetroStone2 that no FIFO address is needed.
+ */
+static int sun4i_hdmi_audio_cpu_dai_probe(struct snd_soc_dai *dai)
+{
+	struct snd_dmaengine_dai_dma_data *dma_data;
+
+	dma_data = devm_kzalloc(dai->dev, sizeof(*dma_data), GFP_KERNEL);
+	if (!dma_data)
+		return -ENOMEM;
+
+	dma_data->addr_width = DMA_SLAVE_BUSWIDTH_4_BYTES;
+	dma_data->maxburst = 8;
+
+	snd_soc_dai_init_dma_data(dai, dma_data, NULL);
+
+	return 0;
+}
+
+static const struct snd_soc_dai_ops sun4i_hdmi_audio_cpu_dai_ops = {
+	.probe	= sun4i_hdmi_audio_cpu_dai_probe,
+};
+
+/*
+ * Only S16_LE stereo is offered: the BSP also listed S20_3LE and S24_LE
+ * but they did not work, and multichannel layouts were never tested.
+ */
+static struct snd_soc_dai_driver sun4i_hdmi_audio_cpu_dai_drv = {
+	.name	= "sun4i-hdmi-cpu-dai",
+	.ops	= &sun4i_hdmi_audio_cpu_dai_ops,
+	.playback = {
+		.stream_name	= "Playback",
+		.channels_min	= 2,
+		.channels_max	= 2,
+		.rates		= SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_44100 |
+				  SNDRV_PCM_RATE_48000 | SNDRV_PCM_RATE_88200 |
+				  SNDRV_PCM_RATE_96000 | SNDRV_PCM_RATE_176400 |
+				  SNDRV_PCM_RATE_192000,
+		.formats	= SNDRV_PCM_FMTBIT_S16_LE,
+	},
+};
+
+static const struct snd_soc_component_driver sun4i_hdmi_audio_cpu_dai_comp = {
+	.name			= "sun4i-hdmi-cpu-dai-component",
+	.legacy_dai_naming	= 1,
+};
+
+/* Buffer limits from the original (tested) patch */
+static const struct snd_pcm_hardware sun4i_hdmi_audio_pcm_hardware = {
+	.info			= SNDRV_PCM_INFO_INTERLEAVED |
+				  SNDRV_PCM_INFO_BLOCK_TRANSFER |
+				  SNDRV_PCM_INFO_MMAP |
+				  SNDRV_PCM_INFO_MMAP_VALID,
+	.formats		= SNDRV_PCM_FMTBIT_S16_LE,
+	.rates			= SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_44100 |
+				  SNDRV_PCM_RATE_48000 | SNDRV_PCM_RATE_88200 |
+				  SNDRV_PCM_RATE_96000 | SNDRV_PCM_RATE_176400 |
+				  SNDRV_PCM_RATE_192000,
+	.rate_min		= 32000,
+	.rate_max		= 192000,
+	.channels_min		= 2,
+	.channels_max		= 2,
+	.buffer_bytes_max	= 128 * 1024,
+	.period_bytes_min	= 4 * 1024,
+	.period_bytes_max	= 32 * 1024,
+	.periods_min		= 2,
+	.periods_max		= 8,
+};
+
+static const struct snd_dmaengine_pcm_config sun4i_hdmi_audio_pcm_config = {
+	.chan_names[SNDRV_PCM_STREAM_PLAYBACK] = "audio-tx",
+	.pcm_hardware		= &sun4i_hdmi_audio_pcm_hardware,
+	.prealloc_buffer_size	= 128 * 1024,
+	.prepare_slave_config	= snd_dmaengine_pcm_prepare_slave_config,
+};
+
+static int sun4i_hdmi_audio_codec_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct sun4i_hdmi *hdmi = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_component *component =
+		snd_soc_rtd_to_codec(rtd, 0)->component;
+	int ret;
+
+	ret = snd_soc_card_jack_new(rtd->card, "HDMI Jack", SND_JACK_LINEOUT,
+				    &hdmi->audio.jack);
+	if (ret) {
+		dev_err(rtd->dev, "HDMI Jack creation failed: %d\n", ret);
+		return ret;
+	}
+
+	return snd_soc_component_set_jack(component, &hdmi->audio.jack, NULL);
+}
+
+int sun4i_hdmi_audio_init(struct sun4i_hdmi *hdmi)
+{
+	struct snd_soc_dai_link *link = &hdmi->audio.link;
+	struct snd_soc_card *card = &hdmi->audio.card;
+	struct device *dev = hdmi->dev;
+	int ret;
+
+	mutex_init(&hdmi->audio.lock);
+
+	if (!of_property_present(dev->of_node, "dmas")) {
+		dev_warn(dev, "No 'dmas' DT property, no HDMI audio\n");
+		return 0;
+	}
+
+	/*
+	 * Everything below is device-managed on the HDMI device, which is
+	 * released when the component is unbound (see vc4_hdmi for why this
+	 * is preferred over DRM-managed actions with ASoC).
+	 */
+	ret = devm_snd_dmaengine_pcm_register(dev, &sun4i_hdmi_audio_pcm_config,
+					      0);
+	if (ret)
+		return dev_err_probe(dev, ret, "Could not register PCM\n");
+
+	ret = devm_snd_soc_register_component(dev,
+					      &sun4i_hdmi_audio_cpu_dai_comp,
+					      &sun4i_hdmi_audio_cpu_dai_drv, 1);
+	if (ret)
+		return dev_err_probe(dev, ret, "Could not register CPU DAI\n");
+
+	ret = drm_connector_hdmi_audio_init(&hdmi->connector, dev,
+					    &sun4i_hdmi_audio_funcs,
+					    2, 0, false, -1);
+	if (ret)
+		return dev_err_probe(dev, ret, "Could not create HDMI codec\n");
+
+	link->cpus		= &hdmi->audio.cpu;
+	link->codecs		= &hdmi->audio.codec;
+	link->platforms		= &hdmi->audio.platform;
+	link->num_cpus		= 1;
+	link->num_codecs	= 1;
+	link->num_platforms	= 1;
+	link->playback_only	= 1;
+	link->name		= "HDMI";
+	link->stream_name	= "HDMI PCM";
+	link->cpus->dai_name	= dev_name(dev);
+	link->codecs->name	=
+		dev_name(&hdmi->connector.hdmi_audio.codec_pdev->dev);
+	link->codecs->dai_name	= "i2s-hifi";
+	link->platforms->name	= dev_name(dev);
+	link->init		= sun4i_hdmi_audio_codec_init;
+
+	card->dai_link		= link;
+	card->num_links		= 1;
+	card->name		= "sun4i-hdmi";
+	card->driver_name	= "sun4i-hdmi";
+	card->dev		= dev;
+	card->owner		= THIS_MODULE;
+	snd_soc_card_set_drvdata(card, hdmi);
+
+	/*
+	 * The deferrable variant binds the card later if hdmi-codec is not
+	 * probed yet (built-in drivers/gpu initcalls run before sound/).
+	 */
+	ret = devm_snd_soc_register_deferrable_card(dev, card);
+
+	/*
+	 * snd_soc_register_card() stores the card in the device drvdata, but
+	 * the HDMI driver uses it for its own structure (unbind). Nothing in
+	 * ASoC reads it back for a card that is not a platform driver, so
+	 * restore it. The card keeps its own pointer to us in card->drvdata.
+	 */
+	dev_set_drvdata(dev, hdmi);
+
+	if (ret)
+		return dev_err_probe(dev, ret, "Could not register sound card\n");
+
+	return 0;
+}
