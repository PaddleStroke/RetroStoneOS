# RetroStoneOS for the RetroStone2 (Allwinner A20)

# Architecture: Cortex-A7, NEON/VFPv4, EABIhf
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_NEON_VFPV4=y

# Build
BR2_DL_DIR="$(HOME)/rsos/dl"
BR2_CCACHE=y
# Also holds linux/linux.hash and uboot/uboot.hash for the custom kernel and
# U-Boot versions; with FORCE_CHECK_HASHES a download that a hash file does
# not list is an error, not a warning (review S10)
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RETROSTONE_PATH)/board/retrostone2/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# Toolchain: Bootlin armv7-eabihf glibc stable (C++ included, kernel headers 5.4)
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV7_EABIHF_GLIBC_STABLE=y

# System: BusyBox init, devtmpfs only (no udev, no mdev), read-only root
BR2_TARGET_GENERIC_HOSTNAME="retrostone"
BR2_TARGET_GENERIC_ISSUE="RetroStoneOS"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_SYSTEM_DHCP=""
# Overlays and post-build: the parts all boards share (board/common), then
# the RetroStone2 ones (docs/porting.md)
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RETROSTONE_PATH)/board/common/rootfs-overlay $(BR2_EXTERNAL_RETROSTONE_PATH)/board/retrostone2/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RETROSTONE_PATH)/board/common/post-build.sh $(BR2_EXTERNAL_RETROSTONE_PATH)/board/retrostone2/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RETROSTONE_PATH)/board/retrostone2/post-image.sh"
# Static BusyBox + the readahead applet (boot time, see the fragment)
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RETROSTONE_PATH)/board/common/busybox.fragment"

# Kernel: Linux 6.18.54 LTS, sunxi_defconfig + board fragments
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.54"
BR2_LINUX_KERNEL_DEFCONFIG="sunxi"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RETROSTONE_PATH)/board/retrostone2/linux.fragment $(BR2_EXTERNAL_RETROSTONE_PATH)/board/retrostone2/linux-patches.fragment"
BR2_LINUX_KERNEL_ZIMAGE=y
# LZ4 zImage (CONFIG_KERNEL_LZ4, builds host-lz4): decompresses several times
# faster than gzip on the A7, for a slightly bigger file (docs/build.md,
# "Boot time")
BR2_LINUX_KERNEL_LZ4=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# dtc -@: keep __symbols__ so U-Boot can apply /boot/overlays/*.dtbo
BR2_LINUX_KERNEL_DTB_OVERLAY_SUPPORT=y
# The .dts is copied into arch/arm/boot/dts/allwinner/ by external.mk
BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun7i-a20-retrostone2"
BR2_RETROSTONE_DTS_DIR="$(BR2_EXTERNAL_RETROSTONE_PATH)/board/retrostone2/dts"
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Firmware for the AP6210 WiFi/BT module (BCM43362 + BCM20710), with AP6212
# (BCM43430 + BCM43430A1) as a fallback. linux-firmware gives the brcmfmac
# SDIO blobs and nvram files; the BT .hcd files come from the Armbian firmware
# repository (see external.mk). Names are fixed up in post-build.sh.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y
BR2_PACKAGE_ARMBIAN_FIRMWARE=y

# Audio
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# Graphics: libdrm (modetest), mesa lima + GLES, kmscube
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LIMA=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_KMSCUBE=y

# Bring-up tools
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_HTOP=y

# Data partition (created at first boot)
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y

# WiFi / Bluetooth (installed, never started automatically)
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y

# Root filesystem (one A/B slot): ext4, mounted read-only, kernel + dtb +
# boot.scr in /boot. 384 MiB = the slot size in genimage.cfg.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="rsos-root"
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# 4 KiB blocks (mke2fs would pick 1 KiB for a filesystem this small).
# No journal and no orphan file: the root is only ever mounted read-only, and
# mounting it read the 32 blocks of the orphan file one synchronous request at
# a time (ext4_init_orphan_info), most of the 38 ms the kernel spent mounting
# the root before starting init (boot round 3).
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit,^has_journal,^orphan_file -b 4096"
# BR2_TARGET_ROOTFS_TAR is not set

# Bootloader: U-Boot v2026.07, A20-OLinuXino-Lime + board fragment
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2026.07"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="A20-OLinuXino-Lime"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RETROSTONE_PATH)/board/retrostone2/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="u-boot-sunxi-with-spl.bin"

# Host tools: genimage for sdcard.img, mkimage for boot.scr, mkfs.vfat + mtools
# for the FAT32 data seed
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# A/B boot state: fw_printenv / fw_setenv (/etc/fw_env.config)
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_UBOOT_TOOLS_FWPRINTENV=y

# RetroStoneOS frontend (display tools for now) and libretro cores
BR2_PACKAGE_RSOS_FRONTEND=y
# Needs the gitignored homebrew/license ok/ folder: set to n in a fresh clone.
BR2_PACKAGE_RSOS_HOMEBREW=y
# The RetroStone VC games (docs/vc-games.md): needs a RetroStone VC checkout
# next to this tree (../RetroStoneVC): set to n without it (CI does).
BR2_PACKAGE_RSOS_VC_GAMES=y
BR2_PACKAGE_LIBRETRO_FCEUMM=y
BR2_PACKAGE_LIBRETRO_SNES9X2005=y
BR2_PACKAGE_LIBRETRO_SNES9X2010=y
BR2_PACKAGE_LIBRETRO_PICODRIVE=y
BR2_PACKAGE_LIBRETRO_GAMBATTE=y
BR2_PACKAGE_LIBRETRO_GPSP=y
BR2_PACKAGE_LIBRETRO_PCSX_REARMED=y
BR2_PACKAGE_LIBRETRO_MAME2003_PLUS=y
BR2_PACKAGE_LIBRETRO_FBNEO=y
BR2_PACKAGE_LIBRETRO_PARALLEL_N64=y
BR2_PACKAGE_LIBRETRO_MUPEN64PLUS_NEXT=y
BR2_PACKAGE_LIBRETRO_BEETLE_PCE_FAST=y
BR2_PACKAGE_LIBRETRO_STELLA2014=y
BR2_PACKAGE_LIBRETRO_PROSYSTEM=y
BR2_PACKAGE_LIBRETRO_HANDY=y
BR2_PACKAGE_LIBRETRO_BEETLE_NGP=y
BR2_PACKAGE_LIBRETRO_BEETLE_WSWAN=y
BR2_PACKAGE_LIBRETRO_GEARSYSTEM=y
BR2_PACKAGE_LIBRETRO_SMSPLUS_GX=y
BR2_PACKAGE_LIBRETRO_GEARBOY=y
BR2_PACKAGE_LIBRETRO_GEARCOLECO=y
BR2_PACKAGE_LIBRETRO_BLUEMSX=y
# Experimental licence-clean alternatives, to measure on the device (docs/cores.md)
BR2_PACKAGE_LIBRETRO_BEETLE_SUPAFAUST=y
BR2_PACKAGE_LIBRETRO_CLOWNMDEMU=y
BR2_PACKAGE_LIBRETRO_GEOLITH=y
# Third batch: computers, fantasy consoles, game engines (docs/cores.md).
# rsos-freedoom (free Doom IWADs) is seeded to /data/roms/doom like rsos-homebrew;
# the Cave Story data (BR2_PACKAGE_LIBRETRO_NXENGINE_CAVESTORY) stays off: owner
# decision (docs/homebrew.md).
BR2_PACKAGE_LIBRETRO_PRBOOM=y
BR2_PACKAGE_RSOS_FREEDOOM=y
BR2_PACKAGE_LIBRETRO_FAKE08=y
BR2_PACKAGE_LIBRETRO_DOSBOX_PURE=y
BR2_PACKAGE_LIBRETRO_SCUMMVM=y
BR2_PACKAGE_LIBRETRO_NXENGINE=y
BR2_PACKAGE_LIBRETRO_BEETLE_SUPERGRAFX=y
BR2_PACKAGE_LIBRETRO_FUSE=y
BR2_PACKAGE_LIBRETRO_CAP32=y
BR2_PACKAGE_LIBRETRO_POKEMINI=y
BR2_PACKAGE_LIBRETRO_VICE=y

# SMB share \RETROSTONE (in-kernel ksmbd): never started at boot. Not wired
# yet: the frontend will start it on demand (docs/rom-transfer.md 3.3,
# docs/build.md "Networking")
BR2_PACKAGE_KSMBD_TOOLS=y

# e2fsprogs: mkfs.ext4/e2fsck for the Bluetooth pairing store
# (/data/rsos/bluetooth.img, see rsos-net)
BR2_PACKAGE_E2FSPROGS=y
# Hardening, pinned explicitly (docs/review/frontend-review.md F-L24)
BR2_SSP_STRONG=y
BR2_RELRO_FULL=y
BR2_FORTIFY_SOURCE_2=y
BR2_PIC_PIE=y
