config BR2_PACKAGE_LIBRETRO_DOSBOX_PURE
	bool "libretro-dosbox-pure"
	depends on BR2_PACKAGE_RSOS_LIBRETRO_ARCH_SUPPORTS # package/libretro-common.mk
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS # shared object loaded with dlopen()
	help
	  DOSBox Pure: DOSBox for libretro, built for playing games. It
	  starts games straight from a .zip, maps the gamepad to the
	  keyboard/mouse, and has its own on-screen keyboard. Uses the
	  DOSBox dynamic recompiler on ARMv7, AArch64 and x86_64.

	  Installs /usr/lib/libretro/dosbox_pure_libretro.so and
	  /usr/share/rsos/cores/dosbox_pure.ini. ROM folder: dos.

	  https://github.com/schellingb/dosbox-pure

comment "libretro-dosbox-pure needs a toolchain w/ C++, threads, dynamic library"
	depends on BR2_PACKAGE_RSOS_LIBRETRO_ARCH_SUPPORTS
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || \
		BR2_STATIC_LIBS
