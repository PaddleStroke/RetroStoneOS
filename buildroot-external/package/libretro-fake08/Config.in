config BR2_PACKAGE_LIBRETRO_FAKE08
	bool "libretro-fake08"
	depends on BR2_PACKAGE_RSOS_LIBRETRO_ARCH_SUPPORTS # package/libretro-common.mk
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_8 # -std=gnu++17
	depends on !BR2_STATIC_LIBS # shared object loaded with dlopen()
	help
	  FAKE-08: an open-source (MIT) PICO-8 cart player, built as a
	  libretro core. Runs .p8 and .p8.png carts; it is not related
	  to Lexaloffle's official PICO-8.

	  Installs /usr/lib/libretro/fake08_libretro.so and
	  /usr/share/rsos/cores/fake08.ini. ROM folder: pico8.

	  https://github.com/jtothebell/fake-08

comment "libretro-fake08 needs a toolchain w/ C++, gcc >= 8, dynamic library"
	depends on BR2_PACKAGE_RSOS_LIBRETRO_ARCH_SUPPORTS
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_GCC_AT_LEAST_8 || \
		BR2_STATIC_LIBS
