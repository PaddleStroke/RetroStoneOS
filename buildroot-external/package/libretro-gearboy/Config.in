config BR2_PACKAGE_LIBRETRO_GEARBOY
	bool "libretro-gearboy"
	depends on BR2_PACKAGE_RSOS_LIBRETRO_ARCH_SUPPORTS # package/libretro-common.mk
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_STATIC_LIBS # shared object loaded with dlopen()
	help
	  Gearboy: Game Boy / Game Boy Color emulator, built as a libretro
	  core (GPL-3.0). Optional per-game alternative to gambatte.

	  Installs /usr/lib/libretro/gearboy_libretro.so and
	  /usr/share/rsos/cores/gearboy.ini.

	  https://github.com/drhelius/Gearboy

comment "libretro-gearboy needs a toolchain w/ C++, dynamic library"
	depends on BR2_PACKAGE_RSOS_LIBRETRO_ARCH_SUPPORTS
	depends on !BR2_INSTALL_LIBSTDCPP || BR2_STATIC_LIBS
