config BR2_PACKAGE_LIBRETRO_PCSX_REARMED
	bool "libretro-pcsx-rearmed"
	depends on BR2_PACKAGE_RSOS_LIBRETRO_ARCH_SUPPORTS # package/libretro-common.mk
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS # shared object loaded with dlopen()
	help
	  PCSX ReARMed: Sony PlayStation emulator optimised for ARM, built
	  as a libretro core with the ari64 ARM dynarec (compiling on a
	  second thread) and the NEON software GPU. Uses a HLE BIOS when
	  no real BIOS file is found.

	  Installs /usr/lib/libretro/pcsx_rearmed_libretro.so and
	  /usr/share/rsos/cores/pcsx_rearmed.ini.

	  https://github.com/libretro/pcsx_rearmed

comment "libretro-pcsx-rearmed needs a toolchain w/ threads, dynamic library"
	depends on BR2_PACKAGE_RSOS_LIBRETRO_ARCH_SUPPORTS
	depends on !BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS
