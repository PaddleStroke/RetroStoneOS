config BR2_PACKAGE_LIBRETRO_PICODRIVE
	bool "libretro-picodrive"
	depends on BR2_PACKAGE_RSOS_LIBRETRO_ARCH_SUPPORTS # package/libretro-common.mk
	depends on !BR2_STATIC_LIBS # shared object loaded with dlopen()
	help
	  PicoDrive: Sega Mega Drive / Genesis, Master System, Game Gear,
	  SG-1000, 32X, Mega-CD / Sega CD and Pico emulator, built as a
	  libretro core with its ARM paths: Cyclone 68000 and DrZ80 asm
	  CPU cores, SH-2 and SSP160x (SVP) dynarecs, and ARM asm
	  renderers and sound mixers.

	  Installs /usr/lib/libretro/picodrive_libretro.so and
	  /usr/share/rsos/cores/picodrive.ini.

	  https://github.com/libretro/picodrive

comment "libretro-picodrive needs a toolchain w/ dynamic library"
	depends on BR2_PACKAGE_RSOS_LIBRETRO_ARCH_SUPPORTS
	depends on BR2_STATIC_LIBS
