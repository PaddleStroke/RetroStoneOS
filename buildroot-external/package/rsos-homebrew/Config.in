config BR2_PACKAGE_RSOS_HOMEBREW
	bool "rsos-homebrew (first-boot seeding of the bundled games)"
	help
	  /usr/bin/rsos-seed-homebrew: on the first boot, copies the
	  games that packages put in /usr/share/rsos/homebrew/<system>/
	  (ROMs, gamelist.xml, media/) to /data/roms/<system>/, never
	  overwriting a file and merging gamelist.xml.

	  The games come from their own packages: rsos-ucity (µCity,
	  gbc), rsos-freedoom (doom), libretro-nxengine's optional Cave
	  Story data. See docs/homebrew.md.

source "$BR2_EXTERNAL_RETROSTONE_PATH/package/rsos-homebrew/rsos-homebrew-open/Config.in"
