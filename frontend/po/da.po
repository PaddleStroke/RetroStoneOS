msgid "hung"
msgstr "hang"

msgctxt "benchmark"
msgid "stopped"
msgstr "stoppet"

msgctxt "benchmark"
msgid "failed"
msgstr "fejlede"

#. TRANSLATORS: in-game menu (Select+X) rows: the label on the left
#. of a 372 px row, a value like "< Slot 1 >" on the right; longer
#. text is cut with "..."
msgid "Resume"
msgstr "Fortsæt"

