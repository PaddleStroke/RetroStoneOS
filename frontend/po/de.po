#, c-format
msgid "Connected: %s"
msgstr "Verbunden: %s"

msgid "Battery empty: game saved"
msgstr "Akku leer: Spiel gespeichert"

#, c-format
msgid "Battery low (%d%%)"
msgstr "Akku schwach (%d %%)"

#. TRANSLATORS: in-game menu > Benchmark, value of the "Runs" row
#. (right half of a 640 px row: keep it short)
#, c-format
msgid "%d setting, about %d min"
msgid_plural "%d settings, about %d min"
msgstr[0] "%d Einstellung, ca. %d Min."
msgstr[1] "%d Einstellungen, ca. %d Min."

