msgstr "Diese Version kann keine GLES-Spiele starten"

msgid "No GPU found (lima)"
msgstr "Keine GPU gefunden (lima)"

msgid "The game was stopped"
msgstr "Das Spiel wurde beendet"

#. TRANSLATORS: shown by the menu after a crash; %s is the
#. signal name in English ("Segmentation fault")
#, c-format
msgid "The emulator crashed (%s). Game saves up to a few seconds ago are kept."
msgstr "Der Emulator ist abgestürzt (%s). Spielstände bis vor wenigen Sekunden bleiben erhalten."

msgid "Could not start the game"
msgstr "Spiel konnte nicht starten"

msgid "The emulator stopped responding. Game saves up to a few seconds ago are kept."
msgstr "Der Emulator reagiert nicht mehr. Spielstände bis vor wenigen Sekunden bleiben erhalten."

msgid "Cannot start the game process"
msgstr "Spielprozess kann nicht starten"

#, c-format
msgid "The emulator failed (code %d)"
msgstr "Emulator-Fehler (Code %d)"

