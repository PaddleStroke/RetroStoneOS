#, c-format
msgid "State slot %d (empty)"
msgstr "Speicherpunkt: Platz %d (leer)"

#. TRANSLATORS: toast: the game was reset (Select+B)
msgctxt "toast"
msgid "Reset"
msgstr "Spiel neu gestartet"

