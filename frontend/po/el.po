#. TRANSLATORS: tagline under the carousel of the built-in themes
#. (uppercase, one line, ~35 characters)
msgctxt "theme"
msgid "Recently played"
msgstr "ΠΑΙΧΤΗΚΑΝ ΠΡΟΣΦΑΤΑ"

