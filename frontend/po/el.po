msgid "delete"
msgstr "σβήσε"

msgid "space"
msgstr "κενό"

msgid "shift"
msgstr "κεφαλαία"

msgid "ok"
msgstr "OK"

#. TRANSLATORS: help bar: B stops the copy
msgid "cancel"
msgstr "άκυρο"

