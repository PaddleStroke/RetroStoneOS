msgid ""
msgstr ""
"Project-Id-Version: RetroStoneOS\n"
"Language: el\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Translator: AI (Claude), review welcome\n"

#. TRANSLATORS: game start error; %s is the zip library's English reason
#, c-format
msgid "Cannot open the zip file (%s)"
msgstr "Δεν ανοίγει το αρχείο zip (%s)"

msgid "No playable file in this zip"
msgstr "Δεν υπάρχει παιχνίδι σε αυτό το zip"

#, c-format
msgid "The file in this zip is too large (%llu MB)"
msgstr "Το αρχείο σε αυτό το zip είναι πολύ μεγάλο (%llu MB)"

#. TRANSLATORS: game start error: file name, then the zip library's English reason
#, c-format
msgid "Cannot extract %s from the zip (%s)"
msgstr "Δεν γίνεται εξαγωγή του %s από το zip (%s)"

msgid "Game file not found"
msgstr "Το αρχείο του παιχνιδιού δεν βρέθηκε"

msgid "7z archives are not supported here: use .zip or unpack it"
msgstr "Τα αρχεία 7z δεν υποστηρίζονται εδώ: χρησιμοποίησε .zip ή αποσυμπίεσέ το"

#, c-format
msgid "Cannot read the game file (%s)"
msgstr "Δεν διαβάζεται το αρχείο του παιχνιδιού (%s)"

#. TRANSLATORS: start of "<system> needs <BIOS file> in /bios" when the system is unknown
msgid "This system"
msgstr "Αυτό το σύστημα"

#. TRANSLATORS: warning shown by the menu before a game starts:
#. "PS1: scph5501.bin is not the expected BIOS dump"
#, c-format
msgid "%s: %s is not the expected BIOS dump"
msgstr "%s: το %s δεν είναι το σωστό BIOS"

#. TRANSLATORS: the last two of a list of BIOS files the user
#. can choose from: "bios_CD_U.bin, bios_CD_E.bin or bios_CD_J.bin"
#, c-format
msgid "%s or %s"
msgstr "%s ή %s"

#. TRANSLATORS: error shown by the menu instead of starting the game:
#. "PS1 needs scph5501.bin in /bios" (system, BIOS file(s), folder)
#, c-format
msgid "%s needs %s in %s"
msgstr "%s: χρειάζεται %s στον φάκελο %s"

#. TRANSLATORS: toast over the last game picture while the saves are written
msgid "Powering off..."
msgstr "Απενεργοποίηση..."

msgid "Player 1 controller disconnected: paused"
msgstr "Το χειριστήριο του παίκτη 1 αποσυνδέθηκε: παύση"

#. TRANSLATORS: toast; %s is the controller's name
#, c-format
msgid "Player 1: %s"
msgstr "Παίκτης 1: %s"

msgid "Saving..."
msgstr "Αποθήκευση..."

msgid "This game cannot save a state now"
msgstr "Αυτό το παιχνίδι δεν μπορεί να αποθηκεύσει κατάσταση τώρα"

#. TRANSLATORS: toast; %s is the system's English error text
#, c-format
msgid "State NOT saved: %s"
msgstr "Η κατάσταση ΔΕΝ αποθηκεύτηκε: %s"

#, c-format
msgid "State loaded, slot %d"
msgstr "Η κατάσταση φορτώθηκε, θέση %d"

#, c-format
msgid "No state in slot %d"
msgstr "Καμία κατάσταση στη θέση %d"

#, c-format
msgid "Cannot load the state of slot %d"
msgstr "Δεν φορτώνεται η κατάσταση της θέσης %d"

#, c-format
msgid "State slot %d"
msgstr "Θέση κατάστασης %d"

#. TRANSLATORS: toast after Select+Left/Right: the slot holds no state
#, c-format
msgid "State slot %d (empty)"
msgstr "Θέση κατάστασης %d (κενή)"

#. TRANSLATORS: toast: the game was reset (Select+B)
msgctxt "toast"
msgid "Reset"
msgstr "Το παιχνίδι ξεκίνησε από την αρχή"

#. TRANSLATORS: toast; %s is the controller's name
#, c-format
msgid "Connected: %s"
msgstr "Συνδέθηκε: %s"

msgid "Battery empty: game saved"
msgstr "Η μπαταρία άδειασε: το παιχνίδι αποθηκεύτηκε"

#, c-format
msgid "Battery low (%d%%)"
msgstr "Χαμηλή μπαταρία (%d%%)"

#. TRANSLATORS: in-game menu > Benchmark, value of the "Runs" row
#. (right half of a 640 px row: keep it short)
#, c-format
msgid "%d setting, about %d min"
msgid_plural "%d settings, about %d min"
msgstr[0] "%d ρύθμιση, ~%d λεπτά"
msgstr[1] "%d ρυθμίσεις, ~%d λεπτά"

msgid "No benchmark for this system"
msgstr "Δεν υπάρχει τεστ ταχύτητας για αυτό το σύστημα"

msgid "Benchmark: this game cannot save a state now"
msgstr "Τεστ: το παιχνίδι δεν μπορεί να αποθηκεύσει κατάσταση τώρα"

#, c-format
msgid "Benchmark: cannot write %s"
msgstr "Τεστ: δεν γίνεται εγγραφή του %s"

msgid "No result to use"
msgstr "Κανένα αποτέλεσμα για χρήση"

#. TRANSLATORS: %s is a benchmark configuration id ("glide-640")
#, c-format
msgid "Unknown configuration %s"
msgstr "Άγνωστη διαμόρφωση %s"

#. TRANSLATORS: %s is the system's English error text
#, c-format
msgid "Could not save: %s"
msgstr "Δεν αποθηκεύτηκε: %s"

#. TRANSLATORS: %s is a benchmark configuration id ("glide-640")
#, c-format
msgid "Saved \"%s\" for this game (applies next start)"
msgstr "Το «%s» αποθηκεύτηκε για αυτό το παιχνίδι (από την επόμενη έναρξη)"

#. TRANSLATORS: configuration id, then the core's name ("mupen64plus_next")
#, c-format
msgid "Saved \"%s\": next start uses %s"
msgstr "Το «%s» αποθηκεύτηκε: την επόμενη φορά με %s"

msgid "The emulator stopped responding"
msgstr "Ο εξομοιωτής δεν αποκρίνεται"

msgid "Cannot load the emulator core"
msgstr "Δεν φορτώνεται ο πυρήνας του εξομοιωτή"

msgid "Benchmark: bad plan"
msgstr "Τεστ: λάθος πλάνο"

msgid "Cannot start the save thread"
msgstr "Δεν ξεκινά η διεργασία αποθήκευσης"

msgid "Cannot open the display"
msgstr "Δεν ανοίγει η οθόνη"

msgid "This core needs a game file"
msgstr "Αυτός ο πυρήνας χρειάζεται αρχείο παιχνιδιού"

msgid "The emulator could not load this game"
msgstr "Ο εξομοιωτής δεν μπόρεσε να φορτώσει αυτό το παιχνίδι"

#. TRANSLATORS: toast: the game continues from the resume state
msgid "Resumed"
msgstr "Συνεχίζουμε!"

#, c-format
msgid "GPU init failed (framebuffer 0x%x)"
msgstr "Αποτυχία εκκίνησης GPU (framebuffer 0x%x)"

msgid "This build cannot run GLES games"
msgstr "Αυτή η έκδοση δεν τρέχει παιχνίδια GLES"

msgid "No GPU found (lima)"
msgstr "Δεν βρέθηκε GPU (lima)"

msgid "The game was stopped"
msgstr "Το παιχνίδι σταμάτησε"

#. TRANSLATORS: shown by the menu after a crash; %s is the
#. signal name in English ("Segmentation fault")
#, c-format
msgid "The emulator crashed (%s). Game saves up to a few seconds ago are kept."
msgstr "Ο εξομοιωτής κράσαρε (%s). Οι αποθηκεύσεις του παιχνιδιού, εκτός από τα τελευταία δευτερόλεπτα, είναι ασφαλείς."

msgid "Could not start the game"
msgstr "Το παιχνίδι δεν ξεκίνησε"

msgid "The emulator stopped responding. Game saves up to a few seconds ago are kept."
msgstr "Ο εξομοιωτής σταμάτησε να αποκρίνεται. Οι αποθηκεύσεις του παιχνιδιού, εκτός από τα τελευταία δευτερόλεπτα, είναι ασφαλείς."

msgid "Cannot start the game process"
msgstr "Δεν ξεκινά η διεργασία του παιχνιδιού"

#, c-format
msgid "The emulator failed (code %d)"
msgstr "Ο εξομοιωτής απέτυχε (κωδικός %d)"

#. TRANSLATORS: in-game menu > Scaling values (right-aligned on a 640 px row)
msgctxt "scaling"
msgid "Integer"
msgstr "Ακέραιο"

msgctxt "scaling"
msgid "Stretch"
msgstr "Πλήρης οθόνη"

msgctxt "scaling"
msgid "Aspect"
msgstr "Αναλογία"

#. TRANSLATORS: in-game menu switch values, shown as "< On >" / "< Off >"
msgctxt "switch"
msgid "On"
msgstr "Ενεργό"

msgctxt "switch"
msgid "Off"
msgstr "Ανενεργό"

#. TRANSLATORS: after a core option's value: saved for this game
#. (keep it short; the help line of the page explains it)
msgctxt "option source"
msgid "(game)"
msgstr "(παιχν.)"

#. TRANSLATORS: after a core option's value: saved for all games of this core
msgctxt "option source"
msgid "(all)"
msgstr "(όλα)"

#. TRANSLATORS: after a core option's value: set by a benchmark run
msgctxt "option source"
msgid "(bench)"
msgstr "(τεστ)"

#. TRANSLATORS: benchmark results page: what happened to a run
msgctxt "benchmark"
msgid "crashed"
msgstr "κράσαρε"

msgctxt "benchmark"
msgid "hung"
msgstr "κόλλησε"

msgctxt "benchmark"
msgid "stopped"
msgstr "σταμάτησε"

msgctxt "benchmark"
msgid "failed"
msgstr "απέτυχε"

#. TRANSLATORS: in-game menu (Select+X) rows: the label on the left
#. of a 372 px row, a value like "< Slot 1 >" on the right; longer
#. text is cut with "..."
msgid "Resume"
msgstr "Συνέχεια"

#. TRANSLATORS: in-game menu value, shown as "< Slot 3 >"
#. TRANSLATORS: in-game menu: under the preview (176 px)
#, c-format
msgid "Slot %d"
msgstr "Θέση %d"

msgid "Save state"
msgstr "Αποθήκευση κατάστασης"

msgid "Load state"
msgstr "Φόρτωση κατάστασης"

#. TRANSLATORS: in-game menu: the CD of a multi-disc game
msgid "Disc"
msgstr "Δίσκος"

#. TRANSLATORS: in-game menu: restart the game (as the console's reset button)
msgid "Reset"
msgstr "Επανεκκίνηση"

msgid "Core options"
msgstr "Ρυθμίσεις πυρήνα"

msgid "Scaling"
msgstr "Κλιμάκωση"

msgid "Show FPS"
msgstr "Εμφάνιση FPS"

msgid "Fast-forward"
msgstr "Γρήγορα μπροστά"

msgid "Benchmark this game"
msgstr "Τεστ ταχύτητας παιχνιδιού"

msgid "Controls"
msgstr "Χειρισμός"

msgid "Exit game"
msgstr "Έξοδος από το παιχνίδι"

#. TRANSLATORS: in-game menu > Core options (640 px rows)
msgid "Save for this game"
msgstr "Αποθήκευση για αυτό το παιχνίδι"

msgid "Save for all games (this core)"
msgstr "Αποθήκευση για όλα (αυτός ο πυρήνας)"

msgid "Reset to defaults"
msgstr "Επαναφορά προεπιλογών"

#. TRANSLATORS: in-game menu > Controls: the row of a player
#, c-format
msgid "Player %d"
msgstr "Παίκτης %d"

#. TRANSLATORS: in-game menu > Controls: a controller's name, and it has an analog stick
#, c-format
msgid "%s (stick)"
msgstr "%s (μοχλός)"

msgid "D-pad as left stick (P1)"
msgstr "Σταυρός ως αριστερός μοχλός (P1)"

msgctxt "d-pad"
msgid "Up"
msgstr "Πάνω"

msgctxt "d-pad"
msgid "Down"
msgstr "Κάτω"

msgctxt "d-pad"
msgid "Left"
msgstr "Αριστερά"

msgctxt "d-pad"
msgid "Right"
msgstr "Δεξιά"

msgid "Left stick"
msgstr "Αριστερός μοχλός"

msgid "Right stick"
msgstr "Δεξιός μοχλός"

#. TRANSLATORS: in-game menu > Benchmark this game: info rows
#. (label on the left, value on the right of a 640 px row)
msgid "Runs"
msgstr "Δοκιμές"

msgid "Each run"
msgstr "Κάθε δοκιμή"

msgid "from now, no input"
msgstr "από εδώ, χωρίς πάτημα"

#. TRANSLATORS: benchmark info row; its value is the key combination that stops it
msgid "Stop"
msgstr "Διακοπή"

#. TRANSLATORS: where the benchmark report is written: keep the path
msgid "/rsos/logs (SD card)"
msgstr "/rsos/logs (κάρτα SD)"

msgid "Results"
msgstr "Αποτελέσματα"

msgid "Start benchmark"
msgstr "Έναρξη τεστ"

#. TRANSLATORS: benchmark results: a run that started from
#. the game's boot (not comparable), or whose last picture
#. was one colour
msgid "not ranked"
msgstr "εκτός κατάταξης"

msgid "blank?"
msgstr "κενή οθόνη;"

msgid "Use this for this game"
msgstr "Χρήση για αυτό το παιχνίδι"

msgid "Resume game"
msgstr "Συνέχεια παιχνιδιού"

#. TRANSLATORS: in-game menu page titles (640 px, large text)
msgid "Benchmark"
msgstr "Τεστ ταχύτητας"

msgid "Benchmark results"
msgstr "Αποτελέσματα τεστ"

#. TRANSLATORS: in-game menu: the save state slot holds nothing
#. (centred in a 176 px preview box)
msgid "Empty"
msgstr "Κενή"

#. TRANSLATORS: in-game menu > Core options, help line (one 592 px
#. line in small text): "(game)", "(all)" and "*" must match the
#. tags shown after the values
msgid "(game) saved for this game, (all) for all games, * saved on leaving"
msgstr "(παιχν.) για αυτό το παιχνίδι, (όλα) για όλα τα παιχνίδια, * στην έξοδο"

#. TRANSLATORS: in-game menu, button help (one 592 px line): A and B are
#. the button names, "</>" the d-pad Left/Right
msgid "A: select  B: resume  </>: change"
msgstr "A: επιλογή  B: συνέχεια  </>: αλλαγή"

msgid "A: select  B: back  </>: change"
msgstr "A: επιλογή  B: πίσω  </>: αλλαγή"

#. TRANSLATORS: in-game menu status line (one 592 px line, small text)
#, c-format
msgid "Saving slot %d..."
msgstr "Αποθήκευση στη θέση %d..."

#, c-format
msgid "Slot %d is empty"
msgstr "Η θέση %d είναι κενή"

#, c-format
msgid "Disc %d inserted"
msgstr "Μπήκε ο δίσκος %d"

#, c-format
msgid "Cannot change to disc %d"
msgstr "Δεν γίνεται αλλαγή στον δίσκο %d"

msgid "Could not save the options"
msgstr "Οι ρυθμίσεις δεν αποθηκεύτηκαν"

#. TRANSLATORS: status line; %s is the game's name
#, c-format
msgid "Saved for %s"
msgstr "Αποθηκεύτηκε για: %s"

#. TRANSLATORS: status line; %s is the emulator core's name ("snes9x")
#, c-format
msgid "Saved for all %s games"
msgstr "Αποθηκεύτηκε για όλα τα παιχνίδια του %s"

msgid "Defaults restored (saved when you leave)"
msgstr "Επαναφορά προεπιλογών (αποθηκεύεται στην έξοδο)"

msgid "Options saved for this game"
msgstr "Οι ρυθμίσεις αποθηκεύτηκαν για αυτό το παιχνίδι"

#. TRANSLATORS: benchmark results page, status line: the report's path
#, c-format
msgid "Table: %s"
msgstr "Πίνακας: %s"

#. TRANSLATORS: toast (one line at the bottom of the game
#. picture); %s is the system's English error text
#, c-format
msgid "Game save failed: %s (retrying)"
msgstr "Η αποθήκευση απέτυχε: %s (ξαναδοκιμάζω)"

#. TRANSLATORS: toast after a failed game save finally worked
msgid "Game saved"
msgstr "Το παιχνίδι αποθηκεύτηκε"

#, c-format
msgid "Auto state NOT saved: %s"
msgstr "Η αυτόματη κατάσταση ΔΕΝ αποθηκεύτηκε: %s"

msgid "Auto state saved"
msgstr "Η αυτόματη κατάσταση αποθηκεύτηκε"

#. TRANSLATORS: toast; %s is the system's English error text
#, c-format
msgid "State %d NOT saved: %s"
msgstr "Η κατάσταση %d ΔΕΝ αποθηκεύτηκε: %s"

#, c-format
msgid "State saved, slot %d"
msgstr "Η κατάσταση αποθηκεύτηκε, θέση %d"

msgid "Save file unreadable: saving disabled"
msgstr "Το αρχείο αποθήκευσης δεν διαβάζεται: η αποθήκευση απενεργοποιήθηκε"

#. TRANSLATORS: the decimal separator of numbers ("1.5 GB"): "," in French.
msgctxt "decimal separator"
msgid "."
msgstr ","

#. TRANSLATORS: the thousands separator ("12,345 games"): a (narrow) no-break
#. space in French, "." in German. Empty: none.
msgctxt "thousands separator"
msgid ","
msgstr "."

#. TRANSLATORS: gigabytes ("Go" in French)
msgctxt "unit"
msgid "GB"
msgstr "GB"

#. TRANSLATORS: megabytes ("Mo" in French)
msgctxt "unit"
msgid "MB"
msgstr "MB"

#. TRANSLATORS: kilobytes ("Ko" in French)
msgctxt "unit"
msgid "KB"
msgstr "KB"

#. TRANSLATORS: a size: number, then unit ("1,5 Go").
#, c-format
msgctxt "unit"
msgid "%s %s"
msgstr "%s %s"

#. TRANSLATORS: short date (strftime): "%d/%m/%Y" in French.
#, no-c-format
msgctxt "strftime"
msgid "%Y-%m-%d"
msgstr "%d/%m/%Y"

#. TRANSLATORS: date and time (strftime): "%d/%m/%Y %H:%M" in French.
#, no-c-format
msgctxt "strftime"
msgid "%Y-%m-%d %H:%M"
msgstr "%d/%m/%Y %H:%M"

msgid "The screen refused this refresh rate"
msgstr "Η οθόνη δεν δέχτηκε αυτή τη συχνότητα"

msgid "No emulator is installed for this game."
msgstr "Δεν υπάρχει εξομοιωτής για αυτό το παιχνίδι."

msgid "This game cannot start (missing BIOS?)."
msgstr "Αυτό το παιχνίδι δεν ξεκινά (λείπει το BIOS;)."

#. TRANSLATORS: %s is a system error message (in English)
#, c-format
msgid "Cannot start the game process (%s)."
msgstr "Δεν ξεκινά η διεργασία του παιχνιδιού (%s)."

msgid "The game could not be started."
msgstr "Το παιχνίδι δεν ξεκίνησε."

#. TRANSLATORS: boot message: the SD card's data partition (games, saves)
msgid "The data partition could not be restored. Your games and saves may need to be copied again."
msgstr "Το διαμέρισμα δεδομένων δεν επανήλθε. Ίσως χρειαστεί να αντιγράψεις ξανά τα παιχνίδια και τις αποθηκεύσεις σου."

msgid "The data partition was unreadable and was reformatted."
msgstr "Το διαμέρισμα δεδομένων δεν διαβαζόταν και διαμορφώθηκε ξανά."

msgid "The data partition has errors: saving may fail. Back up your saves."
msgstr "Το διαμέρισμα δεδομένων έχει σφάλματα: η αποθήκευση μπορεί να αποτύχει. Κάνε αντίγραφο των αποθηκεύσεών σου."

msgid "The last update didn't start; the previous version was restored."
msgstr "Η τελευταία ενημέρωση δεν ξεκίνησε, οπότε επανήλθε η προηγούμενη έκδοση."

msgid "The SD card was checked after an unexpected power loss"
msgstr "Η κάρτα SD ελέγχθηκε μετά από απότομη διακοπή ρεύματος"

#. TRANSLATORS: boot screen under the logo (first start, or after an update)
msgid "Preparing the SD card, please wait..."
msgstr "Προετοιμασία της κάρτας SD, περίμενε..."

#. TRANSLATORS: boot screen under the logo, after the power was cut
msgid "Checking the SD card, please wait..."
msgstr "Έλεγχος της κάρτας SD, περίμενε..."

#. TRANSLATORS: the favorite games collection in the system carousel
#. (big text, uppercase in the built-in themes) and its list header
msgid "Favorites"
msgstr "Αγαπημένα"

#. TRANSLATORS: the recently played games collection in the system
#. carousel (big text, uppercase in the built-in themes) and its list header
msgid "Last played"
msgstr "Πρόσφατα"

#. TRANSLATORS: toast when a system opened from the carousel has no
#. game any more (removed while the console was off)
msgid "No games found any more in this folder"
msgstr "Δεν υπάρχουν πια παιχνίδια σε αυτόν τον φάκελο"

