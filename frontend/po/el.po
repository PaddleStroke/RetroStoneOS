msgstr "Τηλεόραση"

msgid "LCD refresh rate: 60 Hz"
msgstr "Συχνότητα οθόνης: 60 Hz"

msgid "LCD refresh rate: back to 78 Hz"
msgstr "Συχνότητα οθόνης: πάλι 78 Hz"

#. TRANSLATORS: dialog buttons, uppercase, short
msgid "KEEP"
msgstr "ΝΑ ΜΕΙΝΕΙ"

