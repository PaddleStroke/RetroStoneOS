#, c-format
msgid "%d sec ago"
msgid_plural "%d secs ago"
msgstr[0] "πριν %d δευτ."
msgstr[1] "πριν %d δευτ."

#. TRANSLATORS: when a game was last played. Short (~15 characters).
#, c-format
msgid "%d minute ago"
msgid_plural "%d minutes ago"
msgstr[0] "πριν %d λεπτό"
msgstr[1] "πριν %d λεπτά"

