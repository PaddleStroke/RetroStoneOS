#. TRANSLATORS: how the battery level is measured: automatic, from the voltage,
#. or the power chip's (AXP) fuel gauge
msgid "Automatic"
msgstr "Αυτόματο"

msgid "Basic"
msgstr "Απλή"

msgid "Detailed"
msgstr "Αναλυτική"

#. TRANSLATORS: corner of the screen
msgid "Top right"
msgstr "Πάνω δεξιά"

msgid "Top left"
msgstr "Πάνω αριστερά"

msgid "Bottom right"
msgstr "Κάτω δεξιά"

msgid "Bottom left"
msgstr "Κάτω αριστερά"

#. TRANSLATORS: LCD refresh rate choice; "legacy" = the old, original setting
msgid "78 Hz (legacy)"
msgstr "78 Hz (παλιά)"

#. TRANSLATORS: who is player 1 (value shown right of "Player 1"): keep it short
msgid "Auto (the controller that starts the game)"
msgstr "Αυτόματο (όποιο ξεκινά)"

msgid "Built-in"
msgstr "Ενσωματωμένο"

msgid "External"
msgstr "Εξωτερικό"

msgid "Could not save the settings"
msgstr "Οι ρυθμίσεις δεν αποθηκεύτηκαν"

#. TRANSLATORS: brightness value while on HDMI (the TV sets it)
