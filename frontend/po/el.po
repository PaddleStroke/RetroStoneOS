#. emulator name follows "Arcade" (uppercase, one line)
msgctxt "theme"
msgid "Arcade · FinalBurn Neo"
msgstr "ARCADE · FINALBURN NEO"

#. TRANSLATORS: a game metadata value missing from gamelist.xml
#. (developer, publisher, genre)
msgctxt "metadata"
msgid "unknown"
msgstr "άγνωστο"

#. TRANSLATORS: an empty game list (one line, uppercase in some themes)
msgid "no games"
msgstr "κανένα παιχνίδι"

msgid "launch"
msgstr "παίξε"

#. TRANSLATORS: help bar labels (uppercase, short: ~10 characters)
msgid "options"
msgstr "επιλογές"

msgid "favorite"
msgstr "αγαπημένο"

msgid "menu"
msgstr "μενού"

#. TRANSLATORS: toast after X in a game list
msgid "Added to favorites"
msgstr "Προστέθηκε στα αγαπημένα"

msgid "Removed from favorites"
msgstr "Αφαιρέθηκε από τα αγαπημένα"

#. TRANSLATORS: system carousel info bar (uppercase in most themes);
#. the whole bar is ~50 characters wide at 640x480
#, c-format
msgid "%d game available"
msgid_plural "%d games available"
msgstr[0] "%d παιχνίδι"
msgstr[1] "%d παιχνίδια"

#. TRANSLATORS: system carousel info bar, after "N games available, "
#, c-format
msgid "%d favorite"
msgid_plural "%d favorites"
msgstr[0] "%d αγαπημένο"
msgstr[1] "%d αγαπημένα"

#. TRANSLATORS: system carousel info bar: "%1$s" is "N games
#. available", "%2$s" is "M favorites" ("12 games available, 3 favorites")
#, c-format
msgctxt "system info"
msgid "%s, %s"
msgstr "%s, %s"

#. TRANSLATORS: the carousel with no game at all; keep the path
#. /data/roms/<system>/ as it is. Wrapped on up to 3 lines.
msgid "No games found. Copy ROMs to /data/roms/<system>/"
msgstr "Δεν βρέθηκαν παιχνίδια. Αντίγραψε ROM στο /data/roms/<system>/"

#. TRANSLATORS: game metadata date: never played (last played) or no
#. release date known. Short (~15 characters).
msgctxt "date"
msgid "never"
msgstr "ποτέ"

msgctxt "date"
msgid "unknown"
msgstr "άγνωστη"

