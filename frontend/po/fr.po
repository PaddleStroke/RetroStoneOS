# French translation of RetroStoneOS.
# Translated by AI, review welcome: see docs/translating.md.
# Choix : « tu » (console pour enfants), « instantané » = save state,
# « sauvegarde » = la sauvegarde du jeu lui-même, « émulateur » = core,
# « clé USB » = USB drive. Espaces fines insécables avant ? ! ; et %.
msgid ""
msgstr ""
"Project-Id-Version: RetroStoneOS\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Translator: AI (Claude), review welcome\n"

#. TRANSLATORS: game start error; %s is the zip library's English reason
#, c-format
msgid "Cannot open the zip file (%s)"
msgstr "Impossible d’ouvrir le fichier zip (%s)"

msgid "No playable file in this zip"
msgstr "Aucun fichier jouable dans ce zip"

#, c-format
msgid "The file in this zip is too large (%llu MB)"
msgstr "Le fichier de ce zip est trop gros (%llu Mo)"

#. TRANSLATORS: game start error: file name, then the zip library's English reason
#, c-format
msgid "Cannot extract %s from the zip (%s)"
msgstr "Impossible d’extraire %s du zip (%s)"

msgid "Game file not found"
msgstr "Fichier du jeu introuvable"

msgid "7z archives are not supported here: use .zip or unpack it"
msgstr "Les archives 7z ne sont pas prises en charge ici : utilise un .zip ou décompresse-la"

#, c-format
msgid "Cannot read the game file (%s)"
msgstr "Impossible de lire le fichier du jeu (%s)"

#. TRANSLATORS: start of "<system> needs <BIOS file> in /bios" when the system is unknown
msgid "This system"
msgstr "Ce système"

