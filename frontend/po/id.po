#, c-format
msgid "Saved \"%s\": next start uses %s"
msgstr "\"%s\" disimpan: mulai berikutnya pakai %s"

msgid "The emulator stopped responding"
msgstr "Emulator berhenti merespons"

msgid "Cannot load the emulator core"
msgstr "Tidak bisa memuat core emulator"

