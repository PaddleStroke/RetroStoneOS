msgstr "Tes kecepatan: game ini tidak bisa menyimpan state sekarang"

#, c-format
msgid "Benchmark: cannot write %s"
msgstr "Tes kecepatan: tidak bisa menulis %s"

msgid "No result to use"
msgstr "Tidak ada hasil untuk dipakai"

#. TRANSLATORS: %s is a benchmark configuration id ("glide-640")
#, c-format
msgid "Unknown configuration %s"
msgstr "Konfigurasi %s tidak dikenal"

#. TRANSLATORS: %s is the system's English error text
#, c-format
msgid "Could not save: %s"
msgstr "Gagal menyimpan: %s"

