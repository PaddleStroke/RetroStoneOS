#, c-format
msgid "Connected: %s"
msgstr "Koblet til: %s"

msgid "Battery empty: game saved"
msgstr "Batteriet er tomt: spillet er lagret"

#, c-format
msgid "Battery low (%d%%)"
msgstr "Lavt batteri (%d %%)"

#. TRANSLATORS: in-game menu > Benchmark, value of the "Runs" row
#. (right half of a 640 px row: keep it short)
#, c-format
msgid "%d setting, about %d min"
msgid_plural "%d settings, about %d min"
msgstr[0] "%d innstilling, ca. %d min"
msgstr[1] "%d innstillinger, ca. %d min"

msgid "No benchmark for this system"
msgstr "Ingen ytelsestest for dette systemet"

