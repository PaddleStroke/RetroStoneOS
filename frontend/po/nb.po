#, c-format
msgid "State slot %d (empty)"
msgstr "Tilstandsplass %d (tom)"

#. TRANSLATORS: toast: the game was reset (Select+B)
msgctxt "toast"
msgid "Reset"
msgstr "Startet på nytt"

