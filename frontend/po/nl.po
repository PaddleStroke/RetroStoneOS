#, c-format
msgid "Saved \"%s\" for this game (applies next start)"
msgstr "\"%s\" opgeslagen voor dit spel (werkt vanaf de volgende start)"

#. TRANSLATORS: configuration id, then the core's name ("mupen64plus_next")
#, c-format
msgid "Saved \"%s\": next start uses %s"
msgstr "\"%s\" opgeslagen: de volgende start gebruikt %s"

msgid "The emulator stopped responding"
msgstr "De emulator reageert niet meer"

msgid "Cannot load the emulator core"
msgstr "Kan de emulator-core niet laden"

msgid "Benchmark: bad plan"
msgstr "Snelheidstest: ongeldig plan"

msgid "Cannot start the save thread"
msgstr "Kan het opslagproces niet starten"

