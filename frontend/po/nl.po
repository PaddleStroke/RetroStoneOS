msgstr "Snelheidstest: dit spel kan nu geen status opslaan"

#, c-format
msgid "Benchmark: cannot write %s"
msgstr "Snelheidstest: kan %s niet schrijven"

msgid "No result to use"
msgstr "Geen resultaat om te gebruiken"

