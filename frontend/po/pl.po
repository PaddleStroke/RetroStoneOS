msgstr "Emulator przestał odpowiadać. Zapisy gry sprzed kilku sekund są zachowane."

msgid "Cannot start the game process"
msgstr "Nie można uruchomić procesu gry"

#, c-format
msgid "The emulator failed (code %d)"
msgstr "Błąd emulatora (kod %d)"

