#, c-format
msgid "Cannot extract %s from the zip (%s)"
msgstr "Nie można wypakować %s z pliku zip (%s)"

msgid "Game file not found"
msgstr "Nie znaleziono pliku gry"

msgid "7z archives are not supported here: use .zip or unpack it"
msgstr "Archiwa 7z nie są obsługiwane: użyj .zip albo je rozpakuj"

