msgctxt "benchmark"
msgid "crashed"
msgstr "сбой"

msgctxt "benchmark"
msgid "hung"
msgstr "завис"

msgctxt "benchmark"
msgid "stopped"
msgstr "остановлен"

msgctxt "benchmark"
msgid "failed"
msgstr "ошибка"

