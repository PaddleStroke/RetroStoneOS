#. TRANSLATORS: game start error; %s is the zip library's English reason
#, c-format
msgid "Cannot open the zip file (%s)"
msgstr "Не вдається відкрити zip-файл (%s)"

msgid "No playable file in this zip"
msgstr "У цьому zip немає файлу гри"

#, c-format
msgid "The file in this zip is too large (%llu MB)"
msgstr "Файл у цьому zip завеликий (%llu МБ)"

#. TRANSLATORS: game start error: file name, then the zip library's English reason
#, c-format
msgid "Cannot extract %s from the zip (%s)"
msgstr "Не вдається видобути %s із zip (%s)"

msgid "Game file not found"
msgstr "Файл гри не знайдено"

msgid "7z archives are not supported here: use .zip or unpack it"
msgstr "Архіви 7z не підтримуються: використай .zip або розпакуй архів"

#, c-format
msgid "Cannot read the game file (%s)"
msgstr "Не вдається прочитати файл гри (%s)"

#. TRANSLATORS: start of "<system> needs <BIOS file> in /bios" when the system is unknown
msgid "This system"
msgstr "цієї системи"

#. TRANSLATORS: warning shown by the menu before a game starts:
#. "PS1: scph5501.bin is not the expected BIOS dump"
#, c-format
msgid "%s: %s is not the expected BIOS dump"
msgstr "%s: %s — не той файл BIOS"

#. TRANSLATORS: the last two of a list of BIOS files the user
#. can choose from: "bios_CD_U.bin, bios_CD_E.bin or bios_CD_J.bin"
#, c-format
msgid "%s or %s"
msgstr "%s або %s"

#. TRANSLATORS: error shown by the menu instead of starting the game:
#. "PS1 needs scph5501.bin in /bios" (system, BIOS file(s), folder)
#, c-format
msgid "%s needs %s in %s"
msgstr "Для %s потрібен %s у папці %s"

#. TRANSLATORS: toast over the last game picture while the saves are written
msgid "Powering off..."
msgstr "Вимкнення..."

msgid "Player 1 controller disconnected: paused"
msgstr "Геймпад гравця 1 від'єднано: пауза"

#. TRANSLATORS: toast; %s is the controller's name
#, c-format
msgid "Player 1: %s"
msgstr "Гравець 1: %s"

msgid "Saving..."
msgstr "Збереження..."

msgid "This game cannot save a state now"
msgstr "Зараз ця гра не може зберегти стан"

#. TRANSLATORS: toast; %s is the system's English error text
#, c-format
msgid "State NOT saved: %s"
msgstr "Стан НЕ збережено: %s"

#, c-format
msgid "State loaded, slot %d"
msgstr "Стан завантажено, слот %d"

#, c-format
msgid "No state in slot %d"
msgstr "У слоті %d немає стану"

#, c-format
msgid "Cannot load the state of slot %d"
msgstr "Не вдається завантажити стан зі слоту %d"

#, c-format
msgid "State slot %d"
msgstr "Слот стану %d"

#. TRANSLATORS: toast after Select+Left/Right: the slot holds no state
#, c-format
msgid "State slot %d (empty)"
msgstr "Слот стану %d (порожній)"

#. TRANSLATORS: toast: the game was reset (Select+B)
msgctxt "toast"
msgid "Reset"
msgstr "Гру перезапущено"

#. TRANSLATORS: toast; %s is the controller's name
#, c-format
msgid "Connected: %s"
msgstr "Під'єднано: %s"

msgid "Battery empty: game saved"
msgstr "Батарея розряджена: гру збережено"

#, c-format
msgid "Battery low (%d%%)"
msgstr "Низький заряд (%d %%)"

#. TRANSLATORS: in-game menu > Benchmark, value of the "Runs" row
#. (right half of a 640 px row: keep it short)
#, c-format
msgid "%d setting, about %d min"
msgid_plural "%d settings, about %d min"
msgstr[0] "%d варіант, ~%d хв"
msgstr[1] "%d варіанти, ~%d хв"
msgstr[2] "%d варіантів, ~%d хв"

msgid "No benchmark for this system"
msgstr "Для цієї системи немає тесту швидкості"

msgid "Benchmark: this game cannot save a state now"
msgstr "Тест: зараз ця гра не може зберегти стан"

#, c-format
msgid "Benchmark: cannot write %s"
msgstr "Тест: не вдається записати %s"

msgid "No result to use"
msgstr "Немає результату для застосування"

#. TRANSLATORS: %s is a benchmark configuration id ("glide-640")
#, c-format
msgid "Unknown configuration %s"
msgstr "Невідома конфігурація %s"

#. TRANSLATORS: %s is the system's English error text
#, c-format
msgid "Could not save: %s"
msgstr "Не вдалося зберегти: %s"

#. TRANSLATORS: %s is a benchmark configuration id ("glide-640")
#, c-format
msgid "Saved \"%s\" for this game (applies next start)"
msgstr "«%s» збережено для цієї гри (з наступного запуску)"

#. TRANSLATORS: configuration id, then the core's name ("mupen64plus_next")
#, c-format
msgid "Saved \"%s\": next start uses %s"
msgstr "«%s» збережено: під час наступного запуску — %s"

msgid "The emulator stopped responding"
msgstr "Емулятор не відповідає"

msgid "Cannot load the emulator core"
msgstr "Не вдається завантажити ядро емулятора"

msgid "Benchmark: bad plan"
msgstr "Тест: хибний план"

msgid "Cannot start the save thread"
msgstr "Не вдається запустити потік збереження"

msgid "Cannot open the display"
msgstr "Не вдається відкрити екран"

msgid "This core needs a game file"
msgstr "Цьому ядру потрібен файл гри"

msgid "The emulator could not load this game"
msgstr "Емулятор не зміг завантажити цю гру"

#. TRANSLATORS: toast: the game continues from the resume state
msgid "Resumed"
msgstr "Продовжуємо!"

#, c-format
msgid "GPU init failed (framebuffer 0x%x)"
msgstr "Помилка запуску GPU (framebuffer 0x%x)"

msgid "This build cannot run GLES games"
msgstr "Ця збірка не запускає ігри GLES"

msgid "No GPU found (lima)"
msgstr "GPU не знайдено (lima)"

msgid "The game was stopped"
msgstr "Гру зупинено"

#. TRANSLATORS: shown by the menu after a crash; %s is the
#. signal name in English ("Segmentation fault")
#, c-format
msgid "The emulator crashed (%s). Game saves up to a few seconds ago are kept."
msgstr "Емулятор аварійно завершився (%s). Збереження гри, крім останніх секунд, на місці."

msgid "Could not start the game"
msgstr "Не вдалося запустити гру"

msgid "The emulator stopped responding. Game saves up to a few seconds ago are kept."
msgstr "Емулятор перестав відповідати. Збереження гри, крім останніх секунд, на місці."

msgid "Cannot start the game process"
msgstr "Не вдається запустити процес гри"

#, c-format
msgid "The emulator failed (code %d)"
msgstr "Помилка емулятора (код %d)"

#. TRANSLATORS: in-game menu > Scaling values (right-aligned on a 640 px row)
msgctxt "scaling"
msgid "Integer"
msgstr "Кратно"

msgctxt "scaling"
msgid "Stretch"
msgstr "На весь екран"

msgctxt "scaling"
