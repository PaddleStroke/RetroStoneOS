msgstr "збій"

msgctxt "benchmark"
msgid "hung"
msgstr "завис"

msgctxt "benchmark"
msgid "stopped"
msgstr "зупинено"

msgctxt "benchmark"
msgid "failed"
msgstr "помилка"

