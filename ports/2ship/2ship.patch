+// the sample's length in samples, for AdpcmLoop.sampleEnd (0x0C)
+static void SetSampleEnd(SOH::AdpcmLoop& loop, uint32_t codec, uint32_t size) {
+    uint32_t samples;
+    switch (codec) {
+        case 0: // CODEC_ADPCM: 16 samples in 9 bytes
+            samples = size / 9 * 16;
+            break;
+        case 3: // CODEC_SMALL_ADPCM: 16 samples in 5 bytes
+            samples = size / 5 * 16;
+            break;
+        case 1: // CODEC_S8
+            samples = size;
+            break;
+        default: // 16-bit samples
+            samples = size / 2;
+            break;
+    }
+    memcpy(loop.unk_0C, &samples, sizeof(samples));
+}
