+// a length that ends inside the buffer and its guard (none if negative)
+static int DmemFit(uint16_t addr, int nbytes) {
+    long room = (long)sizeof(rspa.buf) - ((long)addr - 0x0330);
+    if (nbytes <= 0 || room <= 0) {
+        return 0;
+    }
+    return nbytes > room ? (int)room : nbytes;
