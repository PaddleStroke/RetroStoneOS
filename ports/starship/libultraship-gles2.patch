+namespace Fast {
+static void RenderbufferDepthStorage(GLsizei width, GLsizei height) {
+#ifdef USE_GLES2
+    glRenderbufferStorage(GL_RENDERBUFFER, sPackedDepthStencil ? GL_DEPTH24_STENCIL8_OES : GL_DEPTH_COMPONENT16,
+                          width, height);
+#else
+    glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH24_STENCIL8, width, height);
+#endif
